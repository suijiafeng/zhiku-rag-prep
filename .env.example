# Local infrastructure only. Copy to .env, choose fresh values. Never commit .env.
POSTGRES_DB=zhiku
POSTGRES_USER=zhiku_local
POSTGRES_PASSWORD=
# HS256 key for locally issued dev tokens, at least 32 random bytes, e.g. `openssl rand -base64 48`.
ZHIKU_JWT_SECRET=
# Local models via Ollama (no paid API, data stays on this machine). Leave as none to disable.
ZHIKU_EMBEDDING_PROVIDER=none
ZHIKU_EMBEDDING_MODEL=bge-m3
ZHIKU_CHAT_PROVIDER=none
ZHIKU_CHAT_MODEL=qwen3.5:latest
ZHIKU_OLLAMA_URL=http://127.0.0.1:11434
# Comma-separated widget host origins allowed to call /api/chat from a browser; empty disables CORS.
ZHIKU_WIDGET_ORIGINS=
